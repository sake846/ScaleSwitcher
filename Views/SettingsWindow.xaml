<Window x:Class="ScaleSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScaleSwitcher.ViewModels"
        Title="{Binding Title}"
        MinWidth="320" MinHeight="480"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="ScaleSwitcher" Style="{StaticResource TextStyle.Title}"/>
                <TextBlock Text="{Binding HeaderDescription}"
                           Style="{StaticResource TextStyle.Caption}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== Footer ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelButtonText}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ButtonStyle.Secondary}"
                        IsCancel="True"
                        Margin="0,0,8,0"/>
                <Button Content="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ButtonStyle.Primary}"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

        <!-- ===== Scrollable content ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,14">

                <!-- Section 1: Target Display -->
                <TextBlock Text="{Binding TargetDisplayHeader}"
                           Style="{StaticResource TextStyle.SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Displays}"
                          SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Height="32"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,16"
                          AutomationProperties.Name="{Binding TargetDisplayHeader}"/>

                <!-- Section 2: Display Name -->
                <TextBlock Text="{Binding CustomDisplayNameHeader}"
                           Style="{StaticResource TextStyle.SectionHeader}"/>
                <CheckBox Content="{Binding UseCustomDisplayNameText}"
                          IsChecked="{Binding UseCustomDisplayName, Mode=TwoWay}"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,6"/>
                <TextBox Text="{Binding DisplayNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding UseCustomDisplayName}"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,16"
                         AutomationProperties.Name="{Binding CustomDisplayNameHeader}"/>

                <!-- Section 3: Scales -->
                <TextBlock Text="{Binding ScalesHeader}"
                           Style="{StaticResource TextStyle.SectionHeader}"/>
                <TextBlock Text="{Binding ScalesDescription}"
                           Style="{StaticResource TextStyle.Caption}"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding ScaleOptions}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayText}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalContentAlignment="Center"
                                      Padding="4,0,0,0"
                                      Height="28"
                                      Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Validation message: no scale selected -->
                <TextBlock Text="{Binding NoScaleSelectedMessage}"
                           Style="{StaticResource TextStyle.Error}"
                           Visibility="{Binding NoScaleErrorVisible}"
                           Margin="0,4,0,0"/>

                <Separator Margin="0,16"/>

                <!-- Section: About this app -->
                <TextBlock Text="{Binding AboutSectionHeader}"
                           Style="{StaticResource TextStyle.SectionHeader}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="ScaleSwitcher"
                               Style="{StaticResource TextStyle.Body}"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding VersionText}"
                               Style="{StaticResource TextStyle.Body}"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
