<Window x:Class="ScaleSwitcher.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsdWindow"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False" Cursor="None">
    <Grid>
        <!--
            OSD overlay uses token brush (Brush.Overlay) and RadiusOverlay.
            Font size is expressed as a binding in code-behind to allow DPI-awareness.
        -->
        <Border Background="{StaticResource Brush.Overlay}"
                CornerRadius="{StaticResource RadiusOverlay}"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="900">
            <TextBlock x:Name="MessageText"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
