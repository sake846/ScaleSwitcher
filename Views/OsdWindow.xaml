<Window x:Class="ScaleSwitcher.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsdWindow"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False" Cursor="None">
    <Grid Margin="24">
        <!--
            OSD overlay uses token brush (Brush.Overlay) and RadiusOverlay.
            Margins and MaxWidth ensure long display names wrap and never overflow the screen.
        -->
        <Border x:Name="OverlayCard"
                Background="{DynamicResource Brush.Overlay}"
                CornerRadius="{DynamicResource RadiusOverlay}"
                Padding="32,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="720"
                MaxHeight="500">
            <TextBlock x:Name="MessageText"
                       Foreground="#FFFFFF"
                       FontSize="36"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
